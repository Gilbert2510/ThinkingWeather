# Configure these in Alibaba Cloud FC, never in the Android build or repository.
QWEATHER_KEY=
QWEATHER_HOST=
# Native Android does not need CORS; leave empty unless an HTTPS web client is intentional.
FC_ALLOWED_ORIGINS=
FC_FETCH_TIMEOUT_MS=8000
FC_MAX_RESPONSE_BYTES=1048576
FC_CACHE_ENTRIES=256
FC_CACHE_BYTES=8388608
# These are per INSTANCE only. Configure global quotas/rate limits in the cloud entrance.
FC_PEER_RPM=60
FC_INSTANCE_RPM=600
FC_UPSTREAM_RPM=180
