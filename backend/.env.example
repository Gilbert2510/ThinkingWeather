# Server only. No QWeather credential belongs in an APK, BuildConfig, Git or chat.
BIND_ADDRESS=127.0.0.1
PORT=8080

# Copy the dedicated HOSTNAME from QWeather console Settings, without https://.
QWEATHER_API_HOST=your-account.xy.qweatherapi.com

# Recommended: Ed25519 JWT (all four are required).
QWEATHER_PRIVATE_KEY_FILE=/run/secrets/qweather-private.pem
QWEATHER_KEY_ID=YOUR_CREDENTIAL_ID
QWEATHER_DEVELOPER_ID=YOUR_DEVELOPER_ID
QWEATHER_PROJECT_ID=YOUR_PROJECT_ID

# Alternative: delete all four JWT variables and set this server-only header key.
# QWEATHER_API_KEY=YOUR_API_KEY

# Current coordinate API is the default. v7 is a deliberate compatibility option.
QWEATHER_WEATHER_API=v1
QWEATHER_ENABLE_WARNINGS=true
QWEATHER_ENABLE_AIR=true
QWEATHER_ENABLE_INDICES=true

# Per process. Set to the quotas and cost budget of your actual subscribed plan.
GATEWAY_PER_PEER_RPM=60
GATEWAY_GLOBAL_RPM=600
QWEATHER_UPSTREAM_RPM=180
